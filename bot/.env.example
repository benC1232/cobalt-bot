# required: bot token from https://discord.com/developers/applications
DISCORD_TOKEN=

# cobalt instance the bot talks to. compose.yaml sets this for you;
# only needed when running the bot outside compose.
COBALT_API_URL=http://localhost:9000/

# optional: override the per-file upload cap in MB (default: derived from the server's boost tier)
# MAX_UPLOAD_MB=10

# optional: extra JSON merged into every cobalt request (see docs/api.md), e.g. {"videoQuality":"720"}
# COBALT_OPTIONS={"videoQuality":"720"}

# required for the telegram bot: token from @BotFather
TELEGRAM_TOKEN=

# optional: override the telegram upload cap in MB (default 50, the bot api limit)
# TELEGRAM_MAX_UPLOAD_MB=50
